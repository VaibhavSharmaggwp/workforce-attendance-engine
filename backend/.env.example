# ========================================================
# Workforce Attendance Engine - Environment Configuration
# Eduqynt Techviista Pvt. Ltd.
# ========================================================

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ams_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Redis Cache / Rate Limiter (Docker / Local)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Kafka Broker (Optional / Dev)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
